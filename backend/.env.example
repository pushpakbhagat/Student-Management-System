# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/studenthub)
MONGO_URI=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts (e.g. 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

PORT=8004

# "production" on your host (Render etc.) - enables Secure / SameSite=None cookies
NODE_ENV=development

# Optional. Defaults to true in production. Set to false when the app and API share one origin
# (e.g. the Docker Compose setup), so login also works over plain http.
# CROSS_SITE_COOKIES=false

# Comma separated frontend URLs allowed to call this API
CLIENT_URLS=http://localhost:5173,https://student-managment-system-by-pushpak.netlify.app

# One-click "Try as admin / student" buttons on the login page (use with seeded demo data)
DEMO_MODE=false
