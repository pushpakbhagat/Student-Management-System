{
  "name": "StudentHub",
  "short_name": "StudentHub",
  "description": "Students, courses, attendance, grades and assignments in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f4fd",
  "theme_color": "#7c3aed",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My timetable", "url": "/student/timetable", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Take attendance", "url": "/admin/attendance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
